{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-development-homepage",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "rogue.codes", "custom_domain": true },
    { "pattern": "www.rogue.codes", "custom_domain": true }
  ],
  "vars": {
    "CORS_ORIGINS": "https://rogue.codes,https://www.rogue.codes"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rogue-code-leads",
      "database_id": "7e69dc92-8a6a-4512-94a1-2b855ddc9f66"
    }
  ],
  // R2 binding (uncomment after enabling R2 in Cloudflare Dashboard):
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "rogue-code-uploads" }
  // ]
}
