# ─── Server-side secrets (NEVER exposed to the browser) ──────────────────────
# These are ONLY accessible in API routes, middleware, and server components.
INTERNAL_API_SECRET=supersecretkey_changethis_in_production

# ─── Public / client-safe variables ──────────────────────────────────────────
# Must be prefixed with NEXT_PUBLIC_ to be bundled into client-side JS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
